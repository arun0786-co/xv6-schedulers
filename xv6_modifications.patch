diff --git a/user/readcount.c b/user/readcount.c
new file mode 100644
index 0000000..6e2665b
--- /dev/null
+++ b/user/readcount.c
@@ -0,0 +1,41 @@
+#include "kernel/types.h"
+#include "kernel/fcntl.h"
+#include "user/user.h"
+
+// Checks getreadcount(): read 100 bytes from a file and see the count grow.
+int
+main(void)
+{
+  char buf[100];
+  uint before, after, grew;
+  int fd, n;
+
+  before = getreadcount();
+  printf("read count before: %u\n", before);
+
+  if((fd = open("/README", O_RDONLY)) < 0){
+    fprintf(2, "readcount: cannot open /README\n");
+    exit(1);
+  }
+  n = read(fd, buf, sizeof(buf));
+  close(fd);
+  if(n != sizeof(buf)){
+    fprintf(2, "readcount: read returned %d, expected %d\n", n, (int)sizeof(buf));
+    exit(1);
+  }
+
+  after = getreadcount();
+  printf("read count after:  %u\n", after);
+
+  // Unsigned subtraction gives the right difference even when the count
+  // wrapped around to 0 in between.
+  grew = after - before;
+  if(grew < (uint)n){
+    printf("FAIL: the count grew by %u after reading %d bytes\n", grew, n);
+    exit(1);
+  }
+  printf("OK: the count grew by %u after reading %d bytes\n", grew, n);
+  if(grew > (uint)n)
+    printf("(other processes read %u bytes in the meantime)\n", grew - n);
+  exit(0);
+}
diff --git a/user/readrace.c b/user/readrace.c
new file mode 100644
index 0000000..0e59177
--- /dev/null
+++ b/user/readrace.c
@@ -0,0 +1,54 @@
+#include "kernel/types.h"
+#include "kernel/fcntl.h"
+#include "user/user.h"
+
+// usage: readrace [procs] [reads]
+// Several processes call read() for one byte at a time, all at once, so on a
+// machine with several CPUs the kernel updates the read count from several
+// CPUs at the same time. The count must grow by exactly procs * reads.
+int
+main(int argc, char *argv[])
+{
+  int procs = argc > 1 ? atoi(argv[1]) : 3;
+  int reads = argc > 2 ? atoi(argv[2]) : 20000;
+  char name[3] = "r0";
+  uint before, grew;
+
+  if(procs < 1 || procs > 9 || reads < 1){
+    fprintf(2, "usage: readrace [procs 1-9] [reads]\n");
+    exit(1);
+  }
+  before = getreadcount();
+  for(int i = 0; i < procs; i++){
+    name[1] = '0' + i;
+    if(fork() == 0){
+      // each child reads its own file, so they do not wait for each
+      // other on one inode lock
+      char c;
+      int fd = open(name, O_CREATE | O_RDWR);
+      for(int k = 0; k < 64; k++)
+        write(fd, "x", 1);
+      close(fd);
+      fd = open(name, O_RDONLY);
+      for(int done = 0; done < reads; ){
+        if(read(fd, &c, 1) == 1){
+          done++;
+        } else {
+          close(fd);
+          fd = open(name, O_RDONLY);
+        }
+      }
+      close(fd);
+      exit(0);
+    }
+  }
+  for(int i = 0; i < procs; i++)
+    wait(0);
+  grew = getreadcount() - before;
+  for(int i = 0; i < procs; i++){
+    name[1] = '0' + i;
+    unlink(name);
+  }
+  printf("readrace: expected %d, counted %u\n", procs * reads, grew);
+  exit(grew == (uint)(procs * reads) ? 0 : 1);
+}
diff --git a/user/schedulertest.c b/user/schedulertest.c
new file mode 100644
index 0000000..db426fc
--- /dev/null
+++ b/user/schedulertest.c
@@ -0,0 +1,51 @@
+#include "kernel/types.h"
+#include "user/user.h"
+
+// usage: schedulertest [-v]
+// Forks NFORK children at once. The first IO of them sleep, as an I/O-bound
+// process would; the rest spin on the CPU. Prints the average number of
+// ticks the children spent running (rtime) and alive but not running
+// (wtime), as reported by waitx(). With -v it also prints each child, in
+// the order they were collected.
+#define NFORK 10
+#define IO 5
+#define SPIN 1000000000
+
+int
+main(int argc, char *argv[])
+{
+  int verbose = argc > 1 && strcmp(argv[1], "-v") == 0;
+  int pids[NFORK];
+  int n, pid, wtime, rtime, twtime = 0, trtime = 0;
+
+  for(n = 0; n < NFORK; n++){
+    pid = fork();
+    if(pid < 0)
+      break;
+    if(pid == 0){
+      if(n < IO){
+        pause(200);
+      } else {
+        for(volatile int i = 0; i < SPIN; i++)
+          ;
+      }
+      exit(0);
+    }
+    pids[n] = pid;
+  }
+  for(int left = n; left > 0; left--){
+    if((pid = waitx(0, &wtime, &rtime)) < 0)
+      break;
+    trtime += rtime;
+    twtime += wtime;
+    if(verbose){
+      int i = 0;
+      while(i < n && pids[i] != pid)
+        i++;
+      printf("child %d (%s, pid %d): rtime %d, wtime %d\n",
+             i, i < IO ? "sleeps" : "spins", pid, rtime, wtime);
+    }
+  }
+  printf("Average rtime %d,  wtime %d\n", trtime / NFORK, twtime / NFORK);
+  exit(0);
+}
