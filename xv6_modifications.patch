+      selected->state = RUNNING;
+      selected->last_run_time = global_time;
+      c->proc = selected;
+      swtch(&c->context, &selected->context);
+      
+      // Update vruntime after process runs
+      uint64 run_time = global_time - selected->last_run_time;
+      selected->vruntime += (run_time * 1024) / selected->weight;
+      
+      c->proc = 0;
+      release(&selected->lock);
+    } else {
+      asm volatile("wfi");
+    }
+
+#else
+    // Default Round Robin scheduler
     int found = 0;
     for(p = proc; p < &proc[NPROC]; p++) {
       acquire(&p->lock);
@@ -456,9 +666,24 @@ scheduler(void)
