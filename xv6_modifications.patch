@@ -434,6 +498,101 @@ scheduler(void)
     intr_on();
     intr_off();
 
+#ifdef SCHEDULER_FCFS
+    // First Come First Serve scheduler
+    struct proc *selected = 0;
+    uint64 earliest_time = ~0ULL;  // Maximum uint64 value
+    
+    for(p = proc; p < &proc[NPROC]; p++) {
+      acquire(&p->lock);
+      if(p->state == RUNNABLE) {
+        if(p->creation_time < earliest_time) {
+          if(selected) release(&selected->lock);
+          selected = p;
+          earliest_time = p->creation_time;
+        } else {
+          release(&p->lock);
+        }
+      } else {
+        release(&p->lock);
+      }
+    }
+    
+    if(selected) {
+      selected->state = RUNNING;
+      c->proc = selected;
+      swtch(&c->context, &selected->context);
+      c->proc = 0;
+      release(&selected->lock);
+    } else {
+      asm volatile("wfi");
+    }
+
+#elif defined(SCHEDULER_CFS)
+    // Completely Fair Scheduler
+    struct proc *selected = 0;
+    uint64 min_vruntime = ~0ULL;  // Maximum uint64 value
+    int runnable_count = 0;
+    
+    // Count runnable processes and find minimum vruntime
+    for(p = proc; p < &proc[NPROC]; p++) {
+      acquire(&p->lock);
+      if(p->state == RUNNABLE) {
+        runnable_count++;
+        if(p->vruntime < min_vruntime) {
+          min_vruntime = p->vruntime;
+        }
+      }
+      release(&p->lock);
+    }
+    
+    // Find process with minimum vruntime
+    for(p = proc; p < &proc[NPROC]; p++) {
+      acquire(&p->lock);
+      if(p->state == RUNNABLE && p->vruntime == min_vruntime) {
+        selected = p;
+        break;
+      }
+      release(&p->lock);
+    }
+    
+    if(selected) {
+      // Calculate time slice: target_latency / number_of_runnable_processes
+      // Minimum time slice of 3 ticks
+      uint64 time_slice = 48;  // target_latency
+      if(runnable_count > 0) {
+        time_slice = time_slice / runnable_count;
+        if(time_slice < 3) time_slice = 3;
+      }
+      
+      // Log scheduling decision
+      printf("[Scheduler Tick]\n");
+      for(p = proc; p < &proc[NPROC]; p++) {
+        acquire(&p->lock);
+        if(p->state == RUNNABLE) {
+          printf("PID: %d | vRuntime: %ld\n", p->pid, p->vruntime);
+        }
+        release(&p->lock);
+      }
+      printf("--> Scheduling PID %d (lowest vRuntime)\n", selected->pid);
+      
+      selected->state = RUNNING;
+      selected->last_run_time = global_time;
+      c->proc = selected;
+      swtch(&c->context, &selected->context);
+      
+      // Update vruntime after process runs
+      uint64 run_time = global_time - selected->last_run_time;
+      selected->vruntime += (run_time * 1024) / selected->weight;
+      
+      c->proc = 0;
+      release(&selected->lock);
+    } else {
+      asm volatile("wfi");
+    }
