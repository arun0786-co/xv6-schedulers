+    if((p = pick()) == 0){
+      asm volatile("wfi");
+      continue;
+    }
+    // It is the process's job to release its lock and then reacquire
+    // it before jumping back to us.
+    p->state = RUNNING;
+    c->proc = p;
+    swtch(&c->context, &p->context);
+    c->proc = 0;
+    release(&p->lock);
+
+#elif defined(SCHEDULER_CFS)
+    // Completely Fair Scheduler
+    struct proc *selected = 0;
+    uint64 min_vruntime = ~0ULL;  // Maximum uint64 value
+    int runnable_count = 0;
+    
+    // Count runnable processes and find minimum vruntime
+    for(p = proc; p < &proc[NPROC]; p++) {
+      acquire(&p->lock);
+      if(p->state == RUNNABLE) {
+        runnable_count++;
+        if(p->vruntime < min_vruntime) {
+          min_vruntime = p->vruntime;
+        }
+      }
+      release(&p->lock);
+    }
+    
+    // Find process with minimum vruntime
+    for(p = proc; p < &proc[NPROC]; p++) {
+      acquire(&p->lock);
+      if(p->state == RUNNABLE && p->vruntime == min_vruntime) {
+        selected = p;
+        break;
+      }
+      release(&p->lock);
+    }
+    
+    if(selected) {
+      // Calculate time slice: target_latency / number_of_runnable_processes
+      // Minimum time slice of 3 ticks
+      uint64 time_slice = 48;  // target_latency
+      if(runnable_count > 0) {
+        time_slice = time_slice / runnable_count;
+        if(time_slice < 3) time_slice = 3;
+      }
+      
+      // Log scheduling decision
+      printf("[Scheduler Tick]\n");
+      for(p = proc; p < &proc[NPROC]; p++) {
+        acquire(&p->lock);
+        if(p->state == RUNNABLE) {
+          printf("PID: %d | vRuntime: %ld\n", p->pid, p->vruntime);
+        }
+        release(&p->lock);
+      }
+      printf("--> Scheduling PID %d (lowest vRuntime)\n", selected->pid);
