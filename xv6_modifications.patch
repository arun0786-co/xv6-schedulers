+# Scheduling policy, chosen at build time: make qemu SCHEDULER=FCFS
+SCHEDULER ?= RR
+ifeq ($(filter $(SCHEDULER),RR FCFS CFS),)
+$(error SCHEDULER must be RR, FCFS or CFS)
+endif
+CFLAGS += -DSCHEDULER_$(SCHEDULER)
