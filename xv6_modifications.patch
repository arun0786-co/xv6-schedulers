+      continue;
+    }
+    // It is the process's job to release its lock and then reacquire
+    // it before jumping back to us.
+    p->state = RUNNING;
+    c->proc = p;
+    swtch(&c->context, &p->context);
+    c->proc = 0;
+    release(&p->lock);
