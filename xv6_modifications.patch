+// Called on every timer interrupt of every CPU: charge the tick to the
+// process running on this CPU, if there is one.
+void
+proctick(void)
+{
+  struct proc *p = myproc();
+
+  if(p == 0)
+    return;
+  acquire(&p->lock);
+  p->rtime++;
+  release(&p->lock);
+}
