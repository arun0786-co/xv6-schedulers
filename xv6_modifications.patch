     else
       state = "???";
     printf("%d %s %s", p->pid, state, p->name);
+    printf("  ctime %u rtime %u nice %d", p->ctime, p->rtime, p->nice);
+#ifdef SCHEDULER_CFS
+    printf(" vruntime %lu", p->vruntime);
