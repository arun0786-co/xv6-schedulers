diff --git a/user/readcount.c b/user/readcount.c
new file mode 100644
index 0000000..02e0d0f
--- /dev/null
+++ b/user/readcount.c
@@ -0,0 +1,44 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+
+int
+main(int argc, char *argv[])
+{
+  int initial_count, final_count;
+  int fd;
+  char buffer[100];
+  int bytes_read;
+
+  // Get initial read count
+  initial_count = getreadcount();
+  printf("Initial read count: %d bytes\n", initial_count);
+
+  // Open a file for reading
+  fd = open("README", 0);
+  if(fd < 0) {
+    printf("Failed to open README file\n");
+    exit(1);
+  }
+
+  // Read 100 bytes from the file
+  bytes_read = read(fd, buffer, 100);
+  printf("Read %d bytes from README\n", bytes_read);
+
+  // Close the file
+  close(fd);
+
+  // Get final read count
+  final_count = getreadcount();
+  printf("Final read count: %d bytes\n", final_count);
+
+  // Verify the increase
+  if(final_count == initial_count + bytes_read) {
+    printf("SUCCESS: Read count increased by %d bytes as expected\n", bytes_read);
+  } else {
+    printf("ERROR: Expected increase of %d bytes, but got %d bytes\n", 
+           bytes_read, final_count - initial_count);
+  }
+
+  exit(0);
+}
diff --git a/user/schedulertest.c b/user/schedulertest.c
new file mode 100644
index 0000000..82afd7a
--- /dev/null
+++ b/user/schedulertest.c
@@ -0,0 +1,68 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+
+int
+main(int argc, char *argv[])
+{
+  int pid1, pid2, pid3;
+  int start_time, end_time;
+  
+  printf("Scheduler Test Program\n");
+  printf("=====================\n");
+  
+  start_time = uptime();
+  printf("Start time: %d\n", start_time);
+  
+  // Create three child processes
+  if((pid1 = fork()) == 0) {
+    // Child 1 - CPU intensive
+    printf("Child 1 (PID: %d) starting CPU intensive task\n", getpid());
+    for(int i = 0; i < 1000000; i++) {
+      // CPU intensive loop
+      volatile int j = i * i;
+      (void)j; // Prevent optimization
+    }
+    printf("Child 1 (PID: %d) completed\n", getpid());
+    exit(0);
+  }
+  
+  if((pid2 = fork()) == 0) {
+    // Child 2 - Mixed workload
+    printf("Child 2 (PID: %d) starting mixed workload\n", getpid());
+    for(int i = 0; i < 500000; i++) {
+      volatile int j = i * i;
+      (void)j;
+      if(i % 10000 == 0) {
+        // Simulate I/O by yielding
+        yield();
+      }
+    }
+    printf("Child 2 (PID: %d) completed\n", getpid());
+    exit(0);
+  }
+  
+  if((pid3 = fork()) == 0) {
+    // Child 3 - I/O intensive
+    printf("Child 3 (PID: %d) starting I/O intensive task\n", getpid());
+    for(int i = 0; i < 100; i++) {
+      // Simulate I/O by sleeping
+      sleep(1);
+    }
+    printf("Child 3 (PID: %d) completed\n", getpid());
+    exit(0);
+  }
+  
+  // Parent waits for all children
+  int status;
+  wait(&status);
+  wait(&status);
+  wait(&status);
+  
+  end_time = uptime();
+  printf("End time: %d\n", end_time);
+  printf("Total execution time: %d ticks\n", end_time - start_time);
+  printf("Scheduler test completed\n");
+  
+  exit(0);
+}
